# docker-compose 用の環境変数テンプレート
# cp .env.example .env して値を埋めてから `docker compose up` を実行する。
# .env は .gitignore 済み — 実値をコミットしないこと。

# ===== Database =====
DB_USER=app_maker
DB_NAME=app_maker
# 例: openssl rand -base64 24
DB_PASSWORD=

# ローカルの postgres コンテナは TLS 非対応のため false。
# Cloud SQL へ接続する場合は true（未設定時の既定も true）。
DB_SSL=false

# ===== Auth =====
# 必須。未設定だとバックエンドは起動時にエラーで停止する。
# 例: openssl rand -base64 48
JWT_SECRET_KEY=

# ===== Gemini =====
# vertex   : Vertex AI（サービスアカウント認証、API キー不要・推奨）
#            ローカルでは事前に以下を実行しておくこと:
#              gcloud auth application-default login
# aistudio : Gemini Developer API（API キー方式）
GEMINI_PROVIDER=vertex

# vertex の場合に必須
GCP_PROJECT_ID=
VERTEX_LOCATION=us-central1

# aistudio の場合のみ必要
GEMINI_API_KEY=

# ローカルは平文 HTTP のため false。Cloud Run では true。
ENFORCE_HTTPS=false

# ===== URLs =====
# ブラウザから見えるバックエンド URL（ビルド時にフロントへ埋め込まれる）
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
